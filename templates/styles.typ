// =============================================================================
// 12306 车票样式定义
// =============================================================================
// 
// 本文件定义车票的视觉样式，包括：
// - 尺寸规格
// - 颜色方案
// - 字体设置
// - 间距规范
//
// =============================================================================

// =============================================================================
// 尺寸规格
// =============================================================================

// 标准火车票尺寸 (85mm × 54mm，与银行卡类似)
#let ticket-width = 85mm
#let ticket-height = 54mm

// 内边距
#let ticket-margin = (
  top: 0mm,
  bottom: 0mm,
  left: 0mm,
  right: 0mm,
)

// 圆角半径
#let ticket-radius = 2mm

// =============================================================================
// 颜色方案
// =============================================================================

// 主色调 - 12306 蓝色
#let primary-color = rgb("#1E88E5")

// 强调色 - 用于车次号等重要信息
#let accent-color = rgb("#1565C0")

// 背景色
#let ticket-bg-color = rgb("#FAFAFA")

// 边框
#let ticket-border = 0.5pt + rgb("#E0E0E0")

// 文字颜色
#let text-primary = rgb("#212121")
#let text-secondary = rgb("#757575")
#let gray-color = rgb("#9E9E9E")

// 票价颜色
#let price-color = rgb("#E53935")

// =============================================================================
// 字体设置
// =============================================================================

// 主字体（优先使用自定义字体，fallback 到系统字体）
#let main-font = (
  "Source Han Sans SC",      // 思源黑体
  "Noto Sans SC",            // Noto 思源黑体
  "Microsoft YaHei",         // 微软雅黑
  "PingFang SC",             // 苹方
  "Heiti SC",                // 黑体
)

// 等宽字体（用于车次号等）
#let mono-font = (
  "JetBrains Mono",
  "Consolas",
  "Courier New",
)

// =============================================================================
// 字号规范
// =============================================================================

// 基础字号
#let base-font-size = 9pt

// 车次号字号
#let train-number-size = 16pt

// 站点名称字号
#let station-font-size = 12pt

// 时间字号
#let time-font-size = 11pt

// 小字号（说明文字）
#let small-font-size = 7pt

// =============================================================================
// 间距规范
// =============================================================================

// 行间距
#let line-gap = 2mm

// 区块间距
#let section-gap = 4mm

// =============================================================================
// 辅助函数
// =============================================================================

/// 创建标签文字（灰色小字）
#let label(content) = text(
  size: small-font-size,
  fill: gray-color,
  content
)

/// 创建值文字（正常大小）
#let value(content) = text(
  size: base-font-size,
  fill: text-primary,
  content
)

/// 创建强调文字
#let emphasis(content) = text(
  size: base-font-size,
  weight: "bold",
  fill: accent-color,
  content
)
